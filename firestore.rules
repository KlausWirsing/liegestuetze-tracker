rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /groups/{groupCode}/players/{uid} {
      allow read: if groupCode is string && groupCode.size() >= 4 && groupCode.size() <= 12;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.name is string
                   && request.resource.data.name.size() <= 24
                   && request.resource.data.pushupsTotal is int
                   && request.resource.data.pushupsTotal >= 0 && request.resource.data.pushupsTotal <= 10000000
                   && request.resource.data.squatsTotal is int
                   && request.resource.data.squatsTotal >= 0 && request.resource.data.squatsTotal <= 10000000
                   && request.resource.data.plankTotal is int
                   && request.resource.data.plankTotal >= 0 && request.resource.data.plankTotal <= 100000000;
    }

    match /groups/{groupCode}/fights/{fightId} {
      allow read: if groupCode is string && groupCode.size() >= 4 && groupCode.size() <= 12;
      allow create: if request.auth != null
                    && request.resource.data.challengerUid == request.auth.uid
                    && request.resource.data.opponentUid is string
                    && request.resource.data.winnerUid is string
                    && request.resource.data.challengerName is string
                    && request.resource.data.opponentName is string
                    && request.resource.data.winnerName is string;
      allow update, delete: if false;
    }
  }
}
